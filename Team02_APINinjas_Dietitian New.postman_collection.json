    {
      "name": "UserLogout",
      "item": [
        {
          "name": "Logout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const testCases = [",
                  "",
                  "    // ========================================================",
                  "    // TC 01 - Invalid Endpoint",
                  "    // ========================================================",
                  "",
                  "    {",
                  "        testCaseId: \"D_Logout_invalid_endpoint_TC_01\",",
                  "        scenario: \"Logout application with invalid endpoint\",",
                  "        endpoint: \"dietitianInvalidendpoint\",",
                  "        expectedStatusCode: 404,",
                  "        expectedStatusLine: \"Not Found\",",
                  "        useToken: true",
                  "    },",
                  "",
                  "",
                  "    // ========================================================",
                  "    // TC 02 - No Token",
                  "    // ========================================================",
                  "",
                  "    {",
                  "        testCaseId: \"D_Logout_no_token_TC_02\",",
                  "        scenario: \"Logout application with no token\",",
                  "        endpoint: \"logoutdietician\",",
                  "        expectedStatusCode: 401,",
                  "        expectedStatusLine: \"Unauthorized\",",
                  "        useToken: false",
                  "    },",
                  "",
                  "",
                  "    // ========================================================",
                  "    // TC 03 - Valid Token",
                  "    // ========================================================",
                  "",
                  "    {",
                  "        testCaseId: \"D_Logout_valid_token_TC_03\",",
                  "        scenario: \"Logout application with valid token\",",
                  "        endpoint: \"logoutdietician\",",
                  "        expectedStatusCode: 200,",
                  "        expectedStatusLine: \"OK\",",
                  "        useToken: true",
                  "    }",
                  "];",
                  "",
                  "",
                  "// ============================================================",
                  "// GET CURRENT TEST INDEX",
                  "// ============================================================",
                  "",
                  "let testIndex = Number(",
                  "    pm.collectionVariables.get(\"logoutTestIndex\")",
                  ");",
                  "",
                  "if (isNaN(testIndex) || testIndex < 0) {",
                  "    testIndex = 0;",
                  "}",
                  "",
                  "",
                  "const currentTest = testCases[testIndex];",
                  "",
                  "",
                  "if (!currentTest) {",
                  "",
                  "    console.log(",
                  "        \"No logout test case found for index:\",",
                  "        testIndex",
                  "    );",
                  "",
                  "    pm.collectionVariables.set(",
                  "        \"logoutTestIndex\",",
                  "        0",
                  "    );",
                  "",
                  "    return;",
                  "}",
                  "",
                  "",
                  "// ============================================================",
                  "// SAVE CURRENT TEST DATA",
                  "// ============================================================",
                  "",
                  "pm.variables.set(",
                  "    \"currentTestCaseId\",",
                  "    currentTest.testCaseId",
                  ");",
                  "",
                  "pm.variables.set(",
                  "    \"currentScenario\",",
                  "    currentTest.scenario",
                  ");",
                  "",
                  "pm.variables.set(",
                  "    \"currentEndpoint\",",
                  "    currentTest.endpoint",
                  ");",
                  "",
                  "pm.variables.set(",
                  "    \"currentExpectedStatus\",",
                  "    currentTest.expectedStatusCode",
                  ");",
                  "",
                  "pm.variables.set(",
                  "    \"currentExpectedStatusLine\",",
                  "    currentTest.expectedStatusLine",
                  ");",
                  "",
                  "",
                  "// ============================================================",
                  "// LOG TEST INFORMATION",
                  "// ============================================================",
                  "",
                  "console.log(\"============================================================\");",
                  "console.log(\"LOGOUT TEST\");",
                  "console.log(\"============================================================\");",
                  "",
                  "console.log(",
                  "    \"Test Case ID:\",",
                  "    currentTest.testCaseId",
                  ");",
                  "",
                  "console.log(",
                  "    \"Scenario:\",",
                  "    currentTest.scenario",
                  ");",
                  "",
                  "console.log(",
                  "    \"Endpoint:\",",
                  "    currentTest.endpoint",
                  ");",
                  "",
                  "console.log(",
                  "    \"Expected Status:\",",
                  "    currentTest.expectedStatusCode",
                  ");",
                  "",
                  "console.log(",
                  "    \"Expected Status Line:\",",
                  "    currentTest.expectedStatusLine",
                  ");",
                  "",
                  "console.log(",
                  "    \"Use Token:\",",
                  "    currentTest.useToken",
                  ");",
                  "",
                  "",
                  "// ============================================================",
                  "// TOKEN HANDLING",
                  "// ============================================================",
                  "",
                  "if (currentTest.useToken === true) {",
                  "",
                  "    const loginToken =",
                  "        pm.collectionVariables.get(\"loginToken\");",
                  "",
                  "    if (!loginToken) {",
                  "",
                  "        console.log(",
                  "            \"ERROR: loginToken does not exist.\"",
                  "        );",
                  "",
                  "        throw new Error(",
                  "            \"Valid-token logout test requires loginToken.\"",
                  "        );",
                  "    }",
                  "",
                  "",
                  "    const tokenType =",
                  "        pm.collectionVariables.get(\"tokenType\") ||",
                  "        \"Bearer\";",
                  "",
                  "",
                  "    pm.request.headers.upsert({",
                  "        key: \"Authorization\",",
                  "        value: tokenType + \" \" + loginToken",
                  "    });",
                  "",
                  "",
                  "    console.log(",
                  "        \"Authorization header added.\"",
                  "    );",
                  "",
                  "} else {",
                  "",
                  "    // Remove Authorization for:",
                  "    // 1. Invalid endpoint",
                  "    // 2. No token",
                  "",
                  "    pm.request.headers.remove(",
                  "        \"Authorization\"",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"Authorization header removed.\"",
                  "    );",
                  "}",
                  "",
                  "",
                  "console.log(\"============================================================\");",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expectedStatus = Number(",
                  "    pm.variables.get(\"currentExpectedStatus\")",
                  ");",
                  "",
                  "const expectedStatusLine =",
                  "    pm.variables.get(\"currentExpectedStatusLine\");",
                  "",
                  "const scenario =",
                  "    pm.variables.get(\"currentScenario\");",
                  "",
                  "const testCaseId =",
                  "    pm.variables.get(\"currentTestCaseId\");",
                  "",
                  "",
                  "console.log(\"============================================================\");",
                  "console.log(\"LOGOUT RESPONSE\");",
                  "console.log(\"============================================================\");",
                  "",
                  "console.log(",
                  "    \"Test Case ID:\",",
                  "    testCaseId",
                  ");",
                  "",
                  "console.log(",
                  "    \"Scenario:\",",
                  "    scenario",
                  ");",
                  "",
                  "console.log(",
                  "    \"Expected Status:\",",
                  "    expectedStatus",
                  ");",
                  "",
                  "console.log(",
                  "    \"Actual Status:\",",
                  "    pm.response.code",
                  ");",
                  "",
                  "console.log(",
                  "    \"Expected Status Line:\",",
                  "    expectedStatusLine",
                  ");",
                  "",
                  "console.log(",
                  "    \"Actual Status Line:\",",
                  "    pm.response.status",
                  ");",
                  "",
                  "console.log(",
                  "    \"Response Body:\",",
                  "    pm.response.text()",
                  ");",
                  "",
                  "console.log(\"============================================================\");",
                  "",
                  "",
                  "// ============================================================",
                  "// STATUS CODE",
                  "// ============================================================",
                  "",
                  "pm.test(",
                  "    \"Status Code | \" + testCaseId,",
                  "    function () {",
                  "",
                  "        pm.expect(pm.response.code)",
                  "            .to.eql(expectedStatus);",
                  "",
                  "    }",
                  ");",
                  "",
                  "",
                  "// ============================================================",
                  "// STATUS LINE",
                  "// ============================================================",
                  "",
                  "pm.test(",
                  "    \"Status Line | \" + testCaseId,",
                  "    function () {",
                  "",
                  "        pm.expect(pm.response.status)",
                  "            .to.eql(expectedStatusLine);",
                  "",
                  "    }",
                  ");",
                  "",
                  "",
                  "// ============================================================",
                  "// LOGOUT SUCCESS",
                  "// ============================================================",
                  "",
                  "if (",
                  "    expectedStatus === 200 &&",
                  "    pm.response.code === 200",
                  ") {",
                  "",
                  "    pm.test(",
                  "        \"Logout should be successful | \" + testCaseId,",
                  "        function () {",
                  "",
                  "            pm.expect(pm.response.code)",
                  "                .to.eql(200);",
                  "",
                  "        }",
                  "    );",
                  "",
                  "",
                  "    // Clear token after successful logout",
                  "    pm.collectionVariables.unset(",
                  "        \"loginToken\"",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"Login token cleared after successful logout.\"",
                  "    );",
                  "}",
                  "",
                  "",
                  "// ============================================================",
                  "// NEGATIVE LOGOUT VALIDATION",
                  "// ============================================================",
                  "",
                  "if (expectedStatus !== 200) {",
                  "",
                  "    pm.test(",
                  "        \"Negative Logout Response | \" + testCaseId,",
                  "        function () {",
                  "",
                  "            pm.expect(pm.response.code)",
                  "                .to.be.oneOf([",
                  "                    400,",
                  "                    401,",
                  "                    404",
                  "                ]);",
                  "",
                  "        }",
                  "    );",
                  "}",
                  "",
                  "",
                  "// ============================================================",
                  "// NEXT LOGOUT TEST",
                  "// ============================================================",
                  "",
                  "let logoutTestIndex = Number(",
                  "    pm.collectionVariables.get(\"logoutTestIndex\")",
                  ");",
                  "",
                  "if (isNaN(logoutTestIndex)) {",
                  "    logoutTestIndex = 0;",
                  "}",
                  "",
                  "logoutTestIndex++;",
                  "",
                  "",
                  "const totalLogoutTests = 3;",
                  "",
                  "",
                  "if (logoutTestIndex < totalLogoutTests) {",
                  "",
                  "    pm.collectionVariables.set(",
                  "        \"logoutTestIndex\",",
                  "        logoutTestIndex",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"Moving to logout test index:\",",
                  "        logoutTestIndex",
                  "    );",
                  "",
                  "",
                  "    // Run same Logout request again",
                  "    pm.execution.setNextRequest(",
                  "        pm.info.requestName",
                  "    );",
                  "",
                  "} else {",
                  "",
                  "    console.log(",
                  "        \"============================================================\"",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"ALL 3 LOGOUT TEST CASES COMPLETED\"",
                  "    );",
                  "",
                  "    console.log(",
                  "        \"============================================================\"",
                  "    );",
                  "",
                  "",
                  "    // Reset for next execution",
                  "    pm.collectionVariables.set(",
                  "        \"logoutTestIndex\",",
                  "        0",
                  "    );",
                  "",
                  "",
                  "    // Continue to next request",
                  "    pm.execution.setNextRequest(",
                  "        \"CreateDietitian\"",
                  "    );",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
