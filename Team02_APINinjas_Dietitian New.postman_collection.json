      "name": "Authentication",
      "item": [
        {
          "name": "UserLogin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "const expectedStatus = Number(pm.variables.get(\"currentExpectedStatus\"));\r",
                  "const expectedStatusLine = pm.variables.get(\"currentExpectedStatusLine\");\r",
                  "const scenario = pm.variables.get(\"currentScenario\");\r",
                  "const testCaseId = pm.variables.get(\"currentTestCaseId\");\r",
                  "\r",
                  "console.log(\"---------------------------------------------------------\");\r",
                  "console.log(\"LOGIN RESPONSE\");\r",
                  "console.log(\"--------------------------------------------------------------\");\r",
                  "\r",
                  "console.log(\"Test Case ID: \" +testCaseId);\r",
                  "console.log(\"Scenario: \" +scenario);\r",
                  "console.log(\"Expected Status: \" +expectedStatus);\r",
                  "console.log(\"Actual Status: \" +pm.response.code);\r",
                  "console.log(\"Expected Status Line: \" +expectedStatusLine);\r",
                  "console.log(\"Actual Status Line: \" +pm.response.status);\r",
                  "\r",
                  "console.log(\"----------------------------------------------------------------\");\r",
                  "\r",
                  "pm.test(\"Status code should be \" + expectedStatus, function () {\r",
                  "        pm.expect(pm.response.code).to.eql(expectedStatus);\r",
                  "    }\r",
                  ");\r",
                  "\r",
                  "pm.test(\"Status line should be \" + expectedStatusLine, function () {\r",
                  "        \r",
                  "        pm.expect(pm.response.status).to.eql(expectedStatusLine);\r",
                  "\r",
                  "    }\r",
                  ");\r",
                  "\r",
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "\r",
                  "    let responseJson;\r",
                  "\r",
                  "    pm.test(\"Response should be valid JSON\", function () {\r",
                  "\r",
                  "            responseJson = pm.response.json();\r",
                  "            pm.expect(responseJson).to.be.an(\"object\");\r",
                  "\r",
                  "        }\r",
                  "    );\r",
                  "\r",
                  "    pm.test(\"Response should contain loginUserEmail\", function () {\r",
                  "\r",
                  "            pm.expect(responseJson).to.have.property(\"loginUserEmail\");\r",
                  "            pm.expect( responseJson.loginUserEmail).to.be.a(\"string\");\r",
                  "            pm.expect(responseJson.loginUserEmail).to.not.be.empty;\r",
                  "\r",
                  "        }\r",
                  "    );\r",
                  "\r",
                  "    pm.test(\"Response should contain roles\", function () {\r",
                  "\r",
                  "            pm.expect( responseJson).to.have.property(\"roles\");\r",
                  "            pm.expect(responseJson.roles).to.be.an(\"array\");\r",
                  "\r",
                  "        }\r",
                  "    );\r",
                  "\r",
                  "    pm.test(\"Response should contain token\", function () {\r",
                  "\r",
                  "            pm.expect(responseJson).to.have.property(\"token\");\r",
                  "            pm.expect(responseJson.token).to.be.a(\"string\");\r",
                  "            pm.expect(responseJson.token).to.not.be.empty;\r",
                  "\r",
                  "        }\r",
                  "    );\r",
                  "\r",
                  "    pm.test(\"Response should contain type\", function () {\r",
                  "\r",
                  "            pm.expect(responseJson).to.have.property(\"type\");\r",
                  "            pm.expect(responseJson.type).to.be.a(\"string\");\r",
                  "\r",
                  "        }\r",
                  "    );\r",
                  "\r",
                  "    pm.test(\"Response should contain userId\", function () {\r",
                  "\r",
                  "            pm.expect(responseJson).to.have.property(\"userId\");\r",
                  "\r",
                  "            pm.expect(responseJson.userId).to.be.a(\"number\");\r",
                  "\r",
                  "        }\r",
                  "    );\r",
                  "\r",
                  "    if (responseJson.token) {\r",
                  "\r",
                  "        pm.collectionVariables.set(\"loginToken\",responseJson.token);\r",
                  "\r",
                  "        console.log(\"Login token saved to collection variable: loginToken\");\r",
                  "\r",
                  "    }\r",
                  "\r",
                  "    if (responseJson.userId !== undefined) {\r",
                  "\r",
                  "        pm.collectionVariables.set(\"loginUserId\",responseJson.userId);\r",
                  "\r",
                  "    }\r",
                  "\r",
                  "    if (responseJson.loginUserEmail) {\r",
                  "\r",
                  "        pm.collectionVariables.set(\"loginUserEmail\", responseJson.loginUserEmail);\r",
                  "\r",
                  "    }\r",
                  "\r",
                  "    console.log(\"Login response: \" +JSON.stringify(responseJson));\r",
                  "\r",
                  "}\r",
                  "\r",
                  "//Loop to get next testdata\r",
                  "let testIndex = Number(pm.collectionVariables.get(\"testIndex\")) || 0;\r",
                  "testIndex++;\r",
                  "\r",
                  "const totalTestCases = 7;\r",
                  "\r",
                  "if (testIndex < totalTestCases) {\r",
                  "pm.collectionVariables.set(\"testIndex\", testIndex);\r",
                  "pm.execution.setNextRequest(pm.info.requestName);//Execute the same request again\r",
                  "} else {\r",
                  "// Reset index back to 0 when complete\r",
                  "pm.collectionVariables.set(\"testIndex\", 0);\r",
                  "pm.execution.setNextRequest(\"CreateDietitian\");\r",
                  "}\r",
                  "\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "\r",
                  "const testCases = [\r",
                  "   //0\r",
                  "    {\r",
                  "        testCaseId: \"D_POST_Login_valid credentials_TC_01\",\r",
                  "        scenario: \"Login with valid credentials\",\r",
                  "        endpoint: \"login\",\r",
                  "        loginUserEmail: \"augHackathon@gmail.com\",\r",
                  "        password: \"test\",\r",
                  "        expectedStatusCode: 200,\r",
                  "        expectedStatusLine: \"OK\"\r",
                  "    },\r",
                  "\r",
                  "    {\r",
                  "        testCaseId: \"D_POST_Login_empty password_TC_02\",\r",
                  "        scenario: \"Login with empty password\",\r",
                  "        endpoint: \"login\",\r",
                  "        loginUserEmail: \"augHackathon@gmail.com\",\r",
                  "        password: \"\",\r",
                  "        expectedStatusCode: 400,\r",
                  "        expectedStatusLine: \"Bad Request\"\r",
                  "    },\r",
                  "    {\r",
                  "        testCaseId: \"D_POST_Login_empty Email_TC_03\",\r",
                  "        scenario: \"Login with empty Email\",\r",
                  "        endpoint: \"login\",\r",
                  "        loginUserEmail: \"\",\r",
                  "        password: \"test\",\r",
                  "        expectedStatusCode: 400,\r",
                  "        expectedStatusLine: \"Bad Request\"\r",
                  "    },\r",
                  "    {\r",
                  "        testCaseId: \"D_POST_Login_no Email and Password_TC_04\",\r",
                  "        scenario: \"Login with no Email and Password\",\r",
                  "        endpoint: \"login\",\r",
                  "        loginUserEmail: \"\",\r",
                  "        password: \"\",\r",
                  "        expectedStatusCode: 400,\r",
                  "        expectedStatusLine: \"Bad Request\"\r",
                  "    },\r",
                  "    {\r",
                  "        testCaseId: \"D_POST_Login_Invalid endpoint_TC_05\",\r",
                  "        scenario: \"Login with Invalid endpoint\",\r",
                  "        endpoint: \"logoutdieti\",\r",
                  "        loginUserEmail: \"augHackathon@gmail.com\",\r",
                  "        password: \"test\",\r",
                  "        expectedStatusCode: 404,\r",
                  "        expectedStatusLine: \"Not Found\"\r",
                  "    },\r",
                  "    {\r",
                  "        testCaseId: \"D_POST_Login_invalid Email_TC_06\",\r",
                  "        scenario: \"Login with invalid Email\",\r",
                  "        endpoint: \"login\",\r",
                  "        loginUserEmail: \"aug@gmail.com\",\r",
                  "        password: \"test\",\r",
                  "        expectedStatusCode: 400,\r",
                  "        expectedStatusLine: \"Bad Request\"\r",
                  "    },\r",
                  "    {\r",
                  "        testCaseId: \"D_POST_Login_invalid Password_TC_07\",\r",
                  "        scenario: \"Login with invalid Password\",\r",
                  "        endpoint: \"login\",\r",
                  "        loginUserEmail: \"augHackathon@gmail.com\",\r",
                  "        password: \"tet\",\r",
                  "        expectedStatusCode: 400,\r",
                  "        expectedStatusLine: \"Bad Request\"\r",
                  "    }\r",
                  "];\r",
                  "\r",
                  "let testIndex = Number(\r",
                  "    pm.collectionVariables.get(\"testIndex\")\r",
                  ");\r",
                  "\r",
                  "if (isNaN(testIndex) || testIndex < 0) {\r",
                  "    testIndex = 0;\r",
                  "}\r",
                  "\r",
                  "const currentTest = testCases[testIndex];\r",
                  "\r",
                  "if (!currentTest) {\r",
                  "\r",
                  "    console.log(\"No test case found for testIndex: \" + testIndex);\r",
                  "    return;\r",
                  "}\r",
                  "\r",
                  "pm.variables.set(\"currentTestCaseId\", currentTest.testCaseId);\r",
                  "\r",
                  "pm.variables.set(\"currentScenario\", currentTest.scenario);\r",
                  "\r",
                  "pm.variables.set(\"currentEndpoint\", currentTest.endpoint);\r",
                  "\r",
                  "pm.variables.set( \"currentExpectedStatus\", currentTest.expectedStatusCode);\r",
                  "\r",
                  "pm.variables.set(\"currentExpectedStatusLine\", currentTest.expectedStatusLine);\r",
                  "\r",
                  "const requestBody = {\r",
                  "   \r",
                  "    userLoginEmail: currentTest.loginUserEmail,\r",
                  "    password: currentTest.password  \r",
                  "};\r",
                  "\r",
                  "pm.variables.set(\"currentBody\",JSON.stringify(requestBody));\r",
                  "\r",
                  "console.log(\"--------------------------------------------------------\");\r",
                  "console.log(\"LOGIN TEST\");\r",
                  "console.log(\"------------------------------------------------------------\");\r",
                  "\r",
                  "console.log(\"Test Case ID: \" +currentTest.testCaseId);\r",
                  "console.log(\"Scenario: \" + currentTest.scenario);\r",
                  "console.log(\"Endpoint: \" + currentTest.endpoint);\r",
                  "console.log(\"loginUserEmail: \" +currentTest.loginUserEmail);\r",
                  "console.log(\"Password: \" + currentTest.password);\r",
                  "console.log(\"Expected Status: \" + currentTest.expectedStatusCode);\r",
                  "console.log(\"Expected Status Line: \" +currentTest.expectedStatusLine);\r",
                  "console.log(\"Request Body: \" + JSON.stringify(requestBody));\r",
                  "\r",
                  "console.log(\"----------------------------------------------------------------------\");\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
